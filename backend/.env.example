# ---------------------------------------------------------------------------
# Voximplant Kit Calls Transcriber - backend configuration
#
# Copy to .env and fill the secrets. Never commit the real .env file.
# Generate all required secrets automatically:
#
#   ./scripts/init-secrets.sh
# ---------------------------------------------------------------------------

APP_ENV=development
APP_NAME=Voximplant Kit Calls Transcriber

# Public origin of this backend. Used to build media (audio) URLs.
PUBLIC_BASE_URL=http://localhost:8000

# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://kitapp:kitapp@localhost:5432/kit_calls_transcriber

# --- Secrets (REQUIRED, no defaults) ----------------------------------------
# 64 hex characters = 32 bytes, used for AES-256-GCM field encryption.
TOKEN_ENCRYPTION_KEY=
# Signing key for short lived JWT access tokens.
JWT_ACCESS_SECRET=
# Signing key for short lived signed media URLs and websocket tickets.
MEDIA_URL_SECRET=

# --- Session / token policy -------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=kit_refresh
# Must stay true in production (HTTPS only cookie).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
MAX_ACTIVE_SESSIONS=10
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
MEDIA_URL_TTL_SECONDS=900
WS_TICKET_TTL_SECONDS=60
PASSWORD_MIN_LENGTH=10

# --- Bootstrap admin (created on first startup only) ------------------------
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=
# When true the bootstrap admin must change the password on first login.
INIT_ADMIN_MUST_CHANGE_PASSWORD=true

# --- Upstream (Voximplant Kit API) protection -------------------------------
# Block requests to loopback/private/link-local addresses (SSRF protection).
ALLOW_PRIVATE_UPSTREAM_HOSTS=false
# Optional comma separated allowlist of upstream hosts, e.g.
# VOXIMPLANT_HOST_ALLOWLIST=kitapi-eu.voximplant.com,kitapi-us.voximplant.com
VOXIMPLANT_HOST_ALLOWLIST=

# --- Transcription runtime --------------------------------------------------
TRANSCRIBE_PERFORMANCE_PROFILE=moderate
WHISPER_INFERENCE_ISOLATION=serialized
WHISPER_TRANSCRIBE_TIMEOUT_SECONDS=420
WHISPER_FALLBACK_TIMEOUT_SECONDS=240
SCHEDULER_POLL_SECONDS=30
# Optional manual overrides, leave empty for auto-detection.
MAX_TRANSCRIBE_CONCURRENCY=
TORCH_NUM_THREADS=
